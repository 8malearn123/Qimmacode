# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# The project-brief form (POST /api/brief) needs at least ONE delivery channel.

# Option A — email via Resend (https://resend.com)
RESEND_API_KEY=
# Where briefs are sent; comma-separate several addresses.
BRIEF_TO_EMAIL=
# Optional sender, e.g. Qimma Code <hello@your-domain.com> (the domain must be verified in Resend).
BRIEF_FROM_EMAIL=

# Option B — webhook (Slack / Discord incoming webhook, Zapier, Make, n8n…)
BRIEF_WEBHOOK_URL=

# Optional — full canonical URL (e.g. https://example.com) for share-image links.
# Leave empty to use Vercel's production domain automatically.
SITE_URL=
